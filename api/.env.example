# Copy to .env (api/.env). Never commit, print or echo a real file.
#
# Local development only: `npm run dev` and `npm run migrate` read this file via dotenv.
# The deployed stages (test, prod) never see it — they read the Secrets Manager secret
# jflow/<stage> instead (tools/put-secret.js writes it from a file like this one).
#
# Three environments, and the stage name IS the environment name:
#
#   dev    local only (npm run dev); never deployed
#   test   bash deploy.sh test  -> secret jflow/test
#   prod   bash deploy.sh prod  -> secret jflow/prod
#
# dev and test share one database (explorer-test, schema jflow), so a local
# `npm run migrate` serves both.

# The database. DB_NAME is the schema; the rest come from whoever administers the host.
DB_HOST=
DB_PORT=
DB_NAME=jflow
DB_USER=
DB_PASSWORD=

# Comma-separated emails seeded as `admin` in allowed_emails by tools/migrate.js and by
# local ensureSchema. INSERT IGNORE: it never demotes or overwrites an existing row.
BOOTSTRAP_ADMIN_EMAILS=

# The local server's port (default 3000; 3000 is taken on this machine, so e.g. 5000).
PORT=

# error | warn | info (default info).
LOG_LEVEL=

# The local auth bypass (every request is local@dev) switches on only when NODE_ENV is
# development or IS_OFFLINE is set, and never inside Lambda. Set it in your shell or here.
#NODE_ENV=development
