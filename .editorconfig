# Copied from workflows/.editorconfig — changes: none
# Matches the style the codebase already has — this file prevents drift, it
# does not introduce a reformat.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,json,yml,yaml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
